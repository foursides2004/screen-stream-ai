# OpenRouter API Configuration
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=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

# Application Secret Key (must match backend-vercel/.env.local APP_SECRET_KEY)
# Generate with: openssl rand -hex 32
APP_SECRET_KEY=your_super_secret_key_here_min_32_chars

# OpenRouter Settings - IMPORTANT: Use /api/v1 for OpenAI SDK
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_REFERER=http://localhost:3000
OPENROUTER_TITLE=Screen Stream AI Assistant

# Screen Capture Settings
SCREEN_CAPTURE_MONITOR=0
SCREEN_CAPTURE_FPS=5
SCREEN_CAPTURE_QUALITY=75
SCREEN_CAPTURE_FORMAT=jpeg
SCREEN_CAPTURE_MONITOR_INDEX=0

# API Connection
API_BASE_URL=http://localhost:3000
API_CHAT_ENDPOINT=/api/chat
API_WS_ENDPOINT=/api/ws
API_TIMEOUT=30